{
	"name": "dragonbytetech/phpstan-xenforo",
	"description": "PHPStan extension for analysing XenForo 2.3 add-ons without false positives from class extensions, entity structures and options",
	"type": "phpstan-extension",
	"license": "MIT",
	"keywords": [
		"phpstan",
		"xenforo",
		"static analysis"
	],
	"require": {
		"php": "^8.1",
		"phpstan/phpstan": "^2.1.26"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.89",
		"xenforo-ltd/xf-cs-fixer": "^1.2"
	},
	"autoload": {
		"psr-4": {
			"DragonByteTech\\PHPStanXenForo\\": "src/"
		}
	},
	"extra": {
		"phpstan": {
			"includes": [
				"extension.neon"
			]
		}
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"analyse": "phpstan analyse",
		"cs": "php-cs-fixer fix --dry-run --diff",
		"cs-fix": "php-cs-fixer fix"
	}
}
